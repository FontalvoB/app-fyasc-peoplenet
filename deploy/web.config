<?xml version="1.0" encoding="utf-8"?>
<!--
  web.config — PWA PeopleNet (app.fyasc.com.co) sobre IIS.

  Requisitos a nivel de SERVIDOR (una sola vez, ver deploy/DEPLOY-PWA-WINDOWS-SERVER.md):
    1. Módulo URL Rewrite instalado.
    2. ARR (Application Request Routing) instalado Y proxy habilitado
       (Application Request Routing Cache → Server Proxy Settings → Enable proxy).
  Este archivo asume el backend kpis-ms en http://localhost:8080 con
  context-path /api (mismo patrón que el proxy de Vite y del web Angular).
-->
<configuration>
  <system.webServer>

    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="Permissions-Policy" value="geolocation=(), microphone=(), camera=(), payment=()" />
      </customHeaders>
    </httpProtocol>

    <staticContent>
      <!-- MIME types críticos para PWA (manifest) e iconografía/fuentes -->
      <remove fileExtension=".svg" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
      <remove fileExtension=".ttf" />
      <mimeMap fileExtension=".ttf" mimeType="font/ttf" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
      <!-- Cache por defecto moderado para estáticos sin hash (fonts/, images/) -->
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="01:00:00" />
    </staticContent>

    <urlCompression doStaticCompression="true" doDynamicCompression="true" />

    <!-- Cuerpos de error del backend (JSON de 401/500 del proxy) pasan intactos -->
    <httpErrors existingResponse="PassThrough" />

    <!-- Cargas masivas de empleados (bulk upload) pueden pesar: 100 MB -->
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="104857600" />
      </requestFiltering>
    </security>

    <rewrite>
      <rules>
        <!-- 1) HTTPS obligatorio. La condición X-Forwarded-Proto evita loop
             de redirects si algún día hay SSL termination (CDN/WAF) delante. -->
        <rule name="HTTP a HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions logicalGrouping="MatchAll">
            <add input="{HTTPS}" pattern="^OFF$" />
            <add input="{HTTP_X_FORWARDED_PROTO}" pattern="https" negate="true" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>

        <!-- 2) API: reverse proxy same-origin al backend local.
             SIN esto, las llamadas serían cross-origin y el preflight OPTIONS
             podría chocar con reglas del WAF (Attack ID 20000001). Same-origin
             = cero CORS, cero preflight. Requiere ARR proxy habilitado. -->
        <rule name="API reverse proxy" stopProcessing="true">
          <match url="^api/(.*)" />
          <action type="Rewrite" url="http://localhost:8080/api/{R:1}" logRewrittenUrl="true" />
        </rule>

        <!-- 3) SPA fallback: cualquier ruta sin extensión y sin archivo cae al
             shell (BrowserRouter). /login, /dashboard/kpis, etc. en deep link. -->
        <rule name="SPA fallback" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            <add input="{URL}" pattern="\.[^/]+$" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>

  </system.webServer>

  <!-- Caching fino:
       - assets/* (JS/CSS con hash en el nombre) → 1 año immutable.
       - sw.js, registerSW.js, manifest.webmanifest, index.html, workbox-*.js
         → NO cache: el navegador consulta el SW en cada visita (autoUpdate)
           y un index.html viejo sería arrastrado por 1 año. -->
  <location path="assets">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" cacheControlCustom="immutable" />
      </staticContent>
    </system.webServer>
  </location>
  <location path="sw.js">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="00:00:00" cacheControlCustom="no-cache" />
      </staticContent>
    </system.webServer>
  </location>
  <location path="registerSW.js">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="00:00:00" cacheControlCustom="no-cache" />
      </staticContent>
    </system.webServer>
  </location>
  <location path="manifest.webmanifest">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="00:00:00" cacheControlCustom="no-cache" />
      </staticContent>
    </system.webServer>
  </location>
  <location path="index.html">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="00:00:00" cacheControlCustom="no-cache" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>
