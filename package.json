    "@ionic/react-router": "^8.4.3",
    "clsx": "^2.1.1",
    "framer-motion": "^13.0.0",
    "ionicons": "^7.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^5.3.4",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@e2e-dev/web": "^0.13.0",
